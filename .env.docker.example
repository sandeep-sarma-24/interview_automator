# Docker Compose overrides. Copy to .env (next to docker-compose.yml).
# These feed ${VAR} substitution in docker-compose.yml. No secrets belong here.

# --- Host Ollama (NOT containerized) ---
# Default works on Docker Desktop (macOS/Windows). On Linux the compose file's
# extra_hosts maps host.docker.internal to the host gateway.
SCRAPER_OLLAMA_URL=http://host.docker.internal:11434
SCRAPER_EMBEDDING_MODEL=nomic-embed-text

# --- Scoring tunables ---
SCRAPER_SHORTLIST_THRESHOLD=0.6
SCRAPER_EXPERIENCE_STRETCH_MONTHS=24

# --- Worker cadence (seconds) ---
WORKER_INTERVAL=1800

# --- Host port for the API (bound to 127.0.0.1 only) ---
HOST_API_PORT=8765

# --- Host port for the frontend dashboard (nginx, bound to 127.0.0.1 only) ---
HOST_FRONTEND_PORT=3000

# --- Optional Gmail discovery ---
# Run `app.cli gmail-auth` on the HOST (interactive OAuth), then place the files
# in ./<data volume>/secrets. Paths below are inside the container.
SCRAPER_GMAIL_CREDENTIALS=/data/secrets/gmail_credentials.json
SCRAPER_GMAIL_TOKEN=/data/secrets/gmail_token.json
