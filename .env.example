# Copy to .env and adjust. Loaded by app/config.py.
# All paths default under ./data if unset.

# Base directory for the SQLite DB, resumes, backups (absolute path recommended).
SCRAPER_BASE_DIR=/Users/mohit.kumar/Scraper/data

# --- API ---
# Bind to the Tailscale interface in production, NOT 0.0.0.0.
SCRAPER_API_HOST=127.0.0.1
SCRAPER_API_PORT=8765

# --- Scoring / embeddings (M2) ---
SCRAPER_OLLAMA_URL=http://localhost:11434
SCRAPER_EMBEDDING_MODEL=nomic-embed-text
# Jobs at/above this total score (or any LEAP) are SHORTLISTED.
SCRAPER_SHORTLIST_THRESHOLD=0.6
# Seniority stretch tolerance, in months, for the hard experience gate.
SCRAPER_EXPERIENCE_STRETCH_MONTHS=24

# --- Gmail discovery (M1) ---
# OAuth client downloaded from Google Cloud console (Desktop app).
SCRAPER_GMAIL_CREDENTIALS=/Users/mohit.kumar/Scraper/secrets/gmail_credentials.json
SCRAPER_GMAIL_TOKEN=/Users/mohit.kumar/Scraper/secrets/gmail_token.json
# Gmail search query for the dedicated job-alerts mailbox.
SCRAPER_GMAIL_QUERY=newer_than:7d (from:linkedin.com OR from:naukri.com OR from:indeed.com OR sub:"job alert")
